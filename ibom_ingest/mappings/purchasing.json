  "pdf": {
    "_comment": "Regexes for text extracted from PDF or plain-text invoices. Named groups map to the column names above.",
    "header": {
      "docNumber": "(?:Invoice|Quote|Quotation|Purchase Order|PO)\\s*(?:No\\.?|Number|#)\\s*[:#]?\\s*([A-Z0-9-]+)",
      "docDate": "(?:Invoice|Quote|Order)?\\s*Date\\s*[:#]?\\s*(\\d{4}-\\d{2}-\\d{2})",
      "poNumber": "(?:Customer PO|Your PO|PO Reference|PO Number)\\s*[:#]?\\s*([A-Z0-9-]+)",
      "vendor": "(?:From|Bill From|Seller|Vendor)\\s*[:]\\s*(.+)",
      "currency": "Currency\\s*[:]\\s*([A-Z]{3})"
    },
    "line": "^\\s*(?P<line>\\d{1,4})\\s+(?P<mpn>[A-Z0-9][A-Z0-9./-]{2,})\\s+(?P<description>.+?)\\s+(?P<quantity>\\d+(?:\\.\\d+)?)\\s+(?P<uom>[A-Za-z]{1,5})\\s+\\$?(?P<unitPrice>[\\d,]+\\.\\d{2})\\s+\\$?(?P<extendedPrice>[\\d,]+\\.\\d{2})\\s*$",
    "serials": "(?:S/N|Serials?|Service Tags?)\\s*[:]\\s*(.+)"
  }
