// Cloudflare Workers static-assets config for the docs site and scorecard.
// Workers Builds settings:
//   Build command:  pip install markdown jsonschema && python3 tools/build_site.py -o _site
//   Deploy command: npx wrangler deploy
// GitHub Pages (.github/workflows/pages.yml) builds the same _site folder.
{
  "name": "i-bom-infrastructure",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./_site",
    "not_found_handling": "404-page"
  }
}
